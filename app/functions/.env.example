# Copy to `.env` (git-ignored) and fill in ONE transport, then deploy:
#   cd app && firebase deploy --only functions
#
# Where enquiries land. Defaults to info@legalboutiqueadvisers.com when unset.
# MAIL_TO=info@legalboutiqueadvisers.com
#
# Visible sender. The domain/address must be allowed by whichever transport you pick.
# MAIL_FROM=Legal Boutique Advisers <info@legalboutiqueadvisers.com>

# --- Transport A: Resend (https://resend.com) — needs the domain verified in Resend ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Transport B: your own mailbox over SMTP (no third party, no DNS changes) ---
# SMTP_HOST=smtp.yourhost.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@legalboutiqueadvisers.com
# SMTP_PASS=your-app-password

# --- Testing: log the email instead of sending it ---
# EMAIL_DRY_RUN=1
