# Copy to `.env` (git-ignored), fill in ONE transport, then deploy:
#   cd app && firebase deploy --only functions
#
# --- Transport A: your own Google account (Gmail SMTP) — the one used here ---
# 1. myaccount.google.com → Security → 2-Step Verification: on.
# 2. Security → App passwords → create one for "Mail" (auto-generated 16 chars).
# 3. Optional but recommended: Gmail → Settings → Accounts → "Send mail as" →
#    add info@legalboutiqueadvisers.com and click the confirmation email that
#    arrives in that inbox, so enquiries arrive From the firm's address.
#
# IMPORTANT: Gmail only allows sending From the account address or a verified
# "Send mail as" alias. Until the alias is verified, set MAIL_FROM to the gmail
# address itself (e.g. "Legal Boutique Advisers <eduardoneville82@gmail.com>").
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=eduardoneville82@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Legal Boutique Advisers <info@legalboutiqueadvisers.com>

# Where enquiries land (defaults to info@legalboutiqueadvisers.com):
# MAIL_TO=info@legalboutiqueadvisers.com

# --- Transport B: Resend (needs the domain verified in Resend, i.e. DNS) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Testing: log the email instead of sending it ---
# EMAIL_DRY_RUN=1