{
  "firestore": [
    { "database": "(default)", "rules": "firestore.rules" },
    { "database": "lba-dev", "rules": "firestore.rules" }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "inquiries",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", "lib", ".git", ".env", ".env.*", "*.log"]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    }
  },
  "hosting": [
    {
      "target": "live",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "dev",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
